%% YouTube / stream-site pipeline: detect -> extract -> dual segmented download -> mux -> cleanup
flowchart TD
    A["URL entered in App.tsx"] --> B{"Extractor::detect(url)?<br/>(youtube.rs provider)"}
    B -- no --> F0["Treat as direct file<br/>download_to_file (single job)"]
    B -- yes --> P["Preflight: yt-dlp + ffmpeg on PATH?"]
    P -- missing --> PE["emit youtube-status: error<br/>(which binary + install hint)"]
    P -- ok --> C["Extractor::extract(url)<br/>-> {video_url, audio_url, title}"]

    C --> D1["Job A: download video stream<br/>download_to_file + dynamic segmentation"]
    C --> D2["Job B: download audio stream<br/>download_to_file + dynamic segmentation"]

    D1 --> J{"tokio::join! both complete?"}
    D2 --> J
    J -- either failed --> JE["cleanup temps<br/>emit youtube-status: error"]
    J -- both ok --> M["muxer::mux<br/>ffmpeg -i v -i a -c:v copy -c:a copy"]
    M --> CL["delete temp video + audio files"]
    CL --> OUT["emit youtube-status: complete<br/>single .mp4"]
